# Copy this file to .env and fill in real values.
# .env is gitignored — never commit real secrets.

# runtime
NODE_ENV=development
PORT=3000

# Set to "true" only when running behind a trusted reverse proxy (nginx, load balancer)
# that terminates TLS. Required for secure cookies + correct client IPs behind a proxy.
TRUST_PROXY=false

# Session signing secret — generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Must be long, random, and unique per environment. Rotate if ever leaked.
SESSION_SECRET=replace-with-a-64-char-random-hex-string

# SQLite file path — only used for local dev (see TURSO_DATABASE_URL below).
# Created automatically by db:migrate.
DB_PATH=./data/floridrap.sqlite

# --- Database (Turso / libSQL) ---
# Leave both blank for local development — the app falls back to a plain
# local SQLite file at DB_PATH above, no account needed.
#
# REQUIRED in production (e.g. on Vercel): a serverless host has no
# writable, persistent local disk, so a local file cannot work there.
# Create a free database (no credit card required) at https://turso.tech,
# then: `turso db show <db-name> --url` for TURSO_DATABASE_URL, and
# `turso db tokens create <db-name>` for TURSO_AUTH_TOKEN.
TURSO_DATABASE_URL=libsql://your-database-name.turso.io
TURSO_AUTH_TOKEN=replace-with-a-real-turso-auth-token

# Comma-separated list of admin emails allowed to be promoted via db:seed (demo only)
SEED_ADMIN_EMAIL=admin@floridrapplus.tn
SEED_ADMIN_PASSWORD=ChangeThisPassword123!

# --- Email (Brevo SMTP relay) ---
# Sign up free at https://www.brevo.com, then: Settings > SMTP & API > SMTP
# tab. BREVO_SMTP_USER is the login shown there (looks like an email
# address ending in @smtp-brevo.com); BREVO_SMTP_KEY is the generated SMTP
# key (NOT your Brevo account password, and NOT the separate "API key" —
# use the SMTP key specifically). Free tier: 300 emails/day.
#
# If these are left blank, the app does not crash — it logs what it
# would have sent to the console instead, which is fine for local
# development. Real verification/confirmation emails only go out once
# both are set.
BREVO_SMTP_USER=your-login@smtp-brevo.com
BREVO_SMTP_KEY=replace-with-a-real-brevo-smtp-key
EMAIL_FROM=contact@floridrapplus.tn
EMAIL_FROM_NAME=Floridrap Plus

# Used to build links inside emails (e.g. the email verification link).
# Must be the real public URL once deployed — http://localhost:3000 only
# makes sense while developing locally.
APP_BASE_URL=http://localhost:3000
