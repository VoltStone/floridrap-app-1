<!DOCTYPE html>
<html lang="fr">
<head>
<%- include('partials/head') %>
</head>
<body>
<a href="#main" class="skip-link">Aller au contenu principal</a>
<%- include('partials/header') %>

<main id="main" class="container">
  <p class="breadcrumb"><a href="/">Accueil</a> &nbsp;&gt;&nbsp; <%= activeCategory ? categoryLabels[activeCategory] : 'Boutique' %></p>
  <h1 style="font-size:22px; padding: 6px 0 0;"><%= searchTerm ? `Résultats pour "${searchTerm}"` : (activeCategory ? categoryLabels[activeCategory] : 'Boutique') %></h1>

  <div class="shop-layout">
    <nav class="filters" aria-label="Filtrer par catégorie">
      <h2>Catégories</h2>
      <div class="filter-group">
        <ul>
          <li><a href="/shop" aria-current="<%= !activeCategory %>">Toutes les catégories</a></li>
          <% Object.keys(categoryLabels).forEach(function(key) { %>
            <li><a href="/shop?category=<%= key %>" aria-current="<%= activeCategory === key %>"><%= categoryLabels[key] %></a></li>
          <% }); %>
        </ul>
      </div>
    </nav>

    <section aria-label="Résultats produits">
      <div class="shop-toolbar">
        <span><%= products.length %> produit<%= products.length !== 1 ? 's' : '' %></span>
        <form action="/shop" method="get" class="sort-form">
          <% if (activeCategory) { %><input type="hidden" name="category" value="<%= activeCategory %>"><% } %>
          <label for="sort-select" class="visually-hidden">Trier par</label>
          <select id="sort-select" name="sort">
            <option value="popularity" <%= sort === 'popularity' ? 'selected' : '' %>>Trier par : Popularité</option>
            <option value="price_asc" <%= sort === 'price_asc' ? 'selected' : '' %>>Prix croissant</option>
            <option value="price_desc" <%= sort === 'price_desc' ? 'selected' : '' %>>Prix décroissant</option>
            <option value="newest" <%= sort === 'newest' ? 'selected' : '' %>>Nouveautés</option>
          </select>
          <button type="submit" class="btn btn-outline sort-submit">Trier</button>
        </form>
      </div>

      <% if (products.length === 0) { %>
        <p class="empty-state">Aucun produit ne correspond à votre recherche.</p>
      <% } else { %>
        <ul class="product-grid">
          <% products.forEach(function(p) { %>
            <li class="product-card reveal">
              <a class="card-link" href="/product/<%= p.slug %>">
                <div class="thumb"><img src="<%= p.image_url %>" alt=""></div>
                <div class="product-info">
                  <div class="product-cat"><%= categoryLabels[p.category] %></div>
                  <div class="product-name"><%= p.name %></div>
                  <div class="price-row">
                    <span class="price"><%= p.price.toFixed(3) %> DT</span>
                    <% if (p.compareAtPrice) { %><span class="price-old"><%= p.compareAtPrice.toFixed(3) %> DT</span><% } %>
                  </div>
                </div>
              </a>
            </li>
          <% }); %>
        </ul>
      <% } %>
    </section>
  </div>
</main>

<%- include('partials/footer') %>
</body>
</html>
