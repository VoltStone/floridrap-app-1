<!DOCTYPE html>
<html lang="fr">
<head>
<%- include('partials/head') %>
</head>
<body>
<a href="#main" class="skip-link">Aller au contenu principal</a>
<%- include('partials/header') %>

<main id="main" class="container">
  <div class="form-page">
    <h1 style="font-size:24px; margin-bottom:20px;">Créer un compte</h1>

    <form action="/register" method="post" novalidate>
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">

      <div class="field <%= errors.name ? 'has-error' : '' %>">
        <label for="name">Nom complet</label>
        <input type="text" id="name" name="name" value="<%= values.name || '' %>" required autocomplete="name"
               <% if (errors.name) { %>aria-invalid="true" aria-describedby="name-error"<% } %>>
        <% if (errors.name) { %><p class="error-text" id="name-error"><%= errors.name[0] %></p><% } %>
      </div>

      <div class="field <%= errors.email ? 'has-error' : '' %>">
        <label for="email">E-mail</label>
        <input type="email" id="email" name="email" value="<%= values.email || '' %>" required autocomplete="email"
               <% if (errors.email) { %>aria-invalid="true" aria-describedby="email-error"<% } %>>
        <% if (errors.email) { %><p class="error-text" id="email-error"><%= errors.email[0] %></p><% } %>
      </div>

      <div class="field <%= errors.password ? 'has-error' : '' %>">
        <label for="password">Mot de passe</label>
        <input type="password" id="password" name="password" required autocomplete="new-password"
               <% if (errors.password) { %>aria-invalid="true" aria-describedby="password-error password-hint"<% } else { %>aria-describedby="password-hint"<% } %>>
        <p class="hint" id="password-hint">Au moins 10 caractères.</p>
        <% if (errors.password) { %><p class="error-text" id="password-error"><%= errors.password[0] %></p><% } %>
      </div>

      <div class="field <%= errors.confirmPassword ? 'has-error' : '' %>">
        <label for="confirmPassword">Confirmer le mot de passe</label>
        <input type="password" id="confirmPassword" name="confirmPassword" required autocomplete="new-password"
               <% if (errors.confirmPassword) { %>aria-invalid="true" aria-describedby="confirmPassword-error"<% } %>>
        <% if (errors.confirmPassword) { %><p class="error-text" id="confirmPassword-error"><%= errors.confirmPassword[0] %></p><% } %>
      </div>

      <button type="submit" class="btn btn-lg btn-block">Créer mon compte</button>
    </form>

    <p class="form-footer-note">Déjà un compte ? <a href="/login">Se connecter</a></p>
  </div>
</main>

<%- include('partials/footer') %>
</body>
</html>
