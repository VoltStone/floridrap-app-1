<!DOCTYPE html>
<html lang="fr">
<head>
<%- include('partials/head') %>
</head>
<body>
<a href="#main" class="skip-link">Aller au contenu principal</a>
<%- include('partials/header') %>

<main id="main" class="container">
  <h1 style="font-size:24px; padding: 20px 0 4px;">Bonjour, <%= currentUser.name %></h1>
  <p style="color:var(--color-7); margin-bottom:24px;"><%= currentUser.email %></p>

  <h2 style="font-size:17px;">Historique de commandes</h2>
  <% if (orders.length === 0) { %>
    <p class="empty-state">Vous n'avez pas encore passé de commande. <a href="/shop">Découvrir la boutique</a>.</p>
  <% } else { %>
    <table class="orders-table">
      <thead>
        <tr><th scope="col">Commande</th><th scope="col">Date</th><th scope="col">Statut</th><th scope="col">Total</th></tr>
      </thead>
      <tbody>
        <% orders.forEach(function(o) { %>
          <tr>
            <td><a href="/checkout/confirmation/<%= o.order_number %>"><%= o.order_number %></a></td>
            <td><%= o.created_at %></td>
            <td><%= o.status %></td>
            <td><%= (o.total_cents / 100).toFixed(3) %> DT</td>
          </tr>
        <% }); %>
      </tbody>
    </table>
  <% } %>
</main>

<%- include('partials/footer') %>
</body>
</html>
