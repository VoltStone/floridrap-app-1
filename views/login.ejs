<!DOCTYPE html>
<html lang="fr">
<head>
<%- include('partials/head') %>
</head>
<body>
<a href="#main" class="skip-link">Aller au contenu principal</a>
<%- include('partials/header') %>

<main id="main" class="container">
  <div class="form-page">
    <h1 style="font-size:24px; margin-bottom:20px;">Connexion</h1>

    <% if (errors.form) { %>
      <p class="error-text" role="alert" style="margin-bottom:16px;">
        <%= errors.form[0] %>
        <% if (typeof showResendLink !== 'undefined' && showResendLink) { %>
          <a href="/resend-verification">Renvoyer le lien</a>
        <% } %>
      </p>
    <% } %>

    <form action="/login" method="post" novalidate>
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">

      <div class="field <%= errors.email ? 'has-error' : '' %>">
        <label for="email">E-mail</label>
        <input type="email" id="email" name="email" value="<%= values.email || '' %>" required autocomplete="email"
               <% if (errors.email) { %>aria-invalid="true" aria-describedby="email-error"<% } %>>
        <% if (errors.email) { %><p class="error-text" id="email-error"><%= errors.email[0] %></p><% } %>
      </div>

      <div class="field <%= errors.password ? 'has-error' : '' %>">
        <label for="password">Mot de passe</label>
        <input type="password" id="password" name="password" required autocomplete="current-password"
               <% if (errors.password) { %>aria-invalid="true" aria-describedby="password-error"<% } %>>
        <% if (errors.password) { %><p class="error-text" id="password-error"><%= errors.password[0] %></p><% } %>
      </div>

      <button type="submit" class="btn btn-lg btn-block">Se connecter</button>
    </form>

    <p class="form-footer-note">Pas encore de compte ? <a href="/register">Créer un compte</a></p>
  </div>
</main>

<%- include('partials/footer') %>
</body>
</html>
