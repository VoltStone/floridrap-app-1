<!DOCTYPE html>
<html lang="fr">
<head>
<%- include('../partials/head') %>
</head>
<body>
<a href="#main" class="skip-link">Aller au contenu principal</a>
<%- include('../partials/header') %>
<%- include('../partials/admin-nav') %>

<main id="main" class="container">
  <p class="breadcrumb"><a href="/admin/orders">Commandes</a> &nbsp;&gt;&nbsp; Terminées</p>
  <h1 style="font-size:22px; padding: 6px 0 20px;">Commandes terminées (<%= orders.length %>)</h1>

  <% if (orders.length === 0) { %>
    <p class="empty-state">Aucune commande terminée pour le moment.</p>
  <% } else { %>
    <table class="admin-table">
      <thead>
        <tr>
          <th scope="col">Commande</th>
          <th scope="col">Client</th>
          <th scope="col">Gouvernorat</th>
          <th scope="col">Date</th>
          <th scope="col">Total</th>
        </tr>
      </thead>
      <tbody>
        <% orders.forEach(function(o) { %>
          <tr>
            <td><a href="/admin/orders/<%= o.id %>"><%= o.order_number %></a></td>
            <td><%= o.full_name %></td>
            <td><%= o.governorate %></td>
            <td><%= formatDate(o.created_at) %></td>
            <td><%= (o.total_cents / 100).toFixed(3) %> DT</td>
          </tr>
        <% }); %>
      </tbody>
    </table>
  <% } %>
</main>

<%- include('../partials/footer') %>
</body>
</html>
