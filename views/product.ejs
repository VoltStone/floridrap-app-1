<!DOCTYPE html>
<html lang="fr">
<head>
<%- include('partials/head') %>
</head>
<body>
<a href="#main" class="skip-link">Aller au contenu principal</a>
<%- include('partials/header') %>

<main id="main" class="container">
  <p class="breadcrumb">
    <a href="/">Accueil</a> &nbsp;&gt;&nbsp;
    <a href="/shop?category=<%= product.category %>"><%= product.category %></a> &nbsp;&gt;&nbsp;
    <%= product.name %>
  </p>

  <div class="product-layout">
    <div>
      <div class="gallery">
        <% images.forEach(function(img, i) { %>
          <input type="radio" name="gallery" id="gallery-img-<%= i + 1 %>" <%= i === 0 ? 'checked' : '' %>>
        <% }); %>
        <% images.forEach(function(img, i) { %>
          <figure>
            <img src="<%= img.url %>" alt="<%= product.name %><%= images.length > 1 ? ` — photo ${i + 1} sur ${images.length}` : '' %>">
          </figure>
        <% }); %>
        <% if (images.length > 1) { %>
          <div class="gallery-arrows">
            <% images.forEach(function(img, i) {
                 var n = images.length;
                 var prevIndex = (i === 0 ? n : i) ; // 1-based: wraps to last
                 var nextIndex = (i === n - 1 ? 1 : i + 2); // 1-based: wraps to first
            %>
              <label for="gallery-img-<%= prevIndex %>" class="gallery-prev gallery-prev-<%= i + 1 %>" aria-label="Photo précédente">&#8249;</label>
              <label for="gallery-img-<%= nextIndex %>" class="gallery-next gallery-next-<%= i + 1 %>" aria-label="Photo suivante">&#8250;</label>
            <% }); %>
          </div>
          <div class="gallery-thumbs">
            <% images.forEach(function(img, i) { %>
              <label for="gallery-img-<%= i + 1 %>">
                <img src="<%= img.url %>" alt="">
              </label>
            <% }); %>
          </div>
        <% } %>
      </div>
    </div>

    <div>
      <p class="pd-cat"><%= product.category %></p>
      <h1 class="pd-title"><%= product.name %></h1>
      <div class="pd-price-row">
        <span class="pd-price"><%= product.price.toFixed(3) %> DT</span>
        <% if (product.compareAtPrice) { %><span class="pd-price-old"><%= product.compareAtPrice.toFixed(3) %> DT</span><% } %>
      </div>
      <p class="pd-desc"><%= product.description %></p>

      <form action="/cart/add" method="post">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <input type="hidden" name="productId" value="<%= product.id %>">
        <input type="hidden" name="returnTo" value="/product/<%= product.slug %>">

        <fieldset class="opt-block" style="border:none; padding:0;">
          <legend class="opt-label">Taille</legend>
          <ul class="radio-pill-group">
            <% product.sizes.forEach(function(size, i) { %>
              <li>
                <input type="radio" name="size" id="size-<%= i %>" value="<%= size %>" <%= i === 0 ? 'checked' : '' %>>
                <label for="size-<%= i %>"><%= size %></label>
              </li>
            <% }); %>
          </ul>
        </fieldset>

        <fieldset class="opt-block" style="border:none; padding:0;">
          <legend class="opt-label">Couleur</legend>
          <ul class="radio-pill-group">
            <% product.colors.forEach(function(color, i) { %>
              <li>
                <input type="radio" name="color" id="color-<%= i %>" value="<%= color %>" <%= i === 0 ? 'checked' : '' %>>
                <label for="color-<%= i %>"><%= color %></label>
              </li>
            <% }); %>
          </ul>
        </fieldset>

        <div class="opt-block">
          <label class="opt-label" for="quantity">Quantité</label>
          <div class="qty-field">
            <input type="number" id="quantity" name="quantity" value="1" min="1" max="20" inputmode="numeric">
          </div>
        </div>

        <div class="add-cart-row">
          <button type="submit" class="btn btn-lg btn-block">Ajouter au panier</button>
        </div>
      </form>

      <ul class="pd-meta">
        <li>&#128666; Livraison sous 2 à 4 jours, partout en Tunisie</li>
        <li>&#8635; Retour ou échange gratuit sous 7 jours</li>
        <li>&#128179; Paiement à la livraison disponible</li>
      </ul>
    </div>
  </div>

  <section class="section reveal" style="max-width:760px;" aria-labelledby="specs-heading">
    <div class="section-head"><h2 id="specs-heading">Caractéristiques</h2></div>
    <table class="specs-table">
      <tbody>
        <tr><th scope="row">Matière</th><td><%= product.material %></td></tr>
        <tr><th scope="row">Entretien</th><td><%= product.care %></td></tr>
        <tr><th scope="row">Fabrication</th><td>Confectionné en Tunisie</td></tr>
      </tbody>
    </table>
  </section>

  <% if (related.length > 0) { %>
    <section class="section" aria-labelledby="related-heading">
      <div class="section-head"><h2 id="related-heading">Vous aimerez aussi</h2></div>
      <ul class="product-grid">
        <% related.forEach(function(p) { %>
          <li class="product-card reveal">
            <a class="card-link" href="/product/<%= p.slug %>">
              <div class="thumb"><img src="<%= p.image_url %>" alt=""></div>
              <div class="product-info">
                <div class="product-cat"><%= p.category %></div>
                <div class="product-name"><%= p.name %></div>
                <div class="price-row"><span class="price"><%= p.price.toFixed(3) %> DT</span></div>
              </div>
            </a>
          </li>
        <% }); %>
      </ul>
    </section>
  <% } %>
</main>

<%- include('partials/footer') %>
</body>
</html>
